<Window x:Class="OnlineLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="1.61ONLINE" Height="760" Width="1240" MinHeight="680" MinWidth="1050" WindowStartupLocation="CenterScreen" Background="{StaticResource ShellBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#15171B" BorderBrush="#292C32" BorderThickness="0,0,1,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="24,28,20,26"><TextBlock Text="1.61ONLINE" Foreground="#F4F4F5" FontSize="23" FontWeight="Bold"/><TextBlock Text="COMMUNITY NETWORK" Foreground="#A0A3AA" FontSize="10" Margin="1,5,0,0"/></StackPanel><StackPanel><TextBlock Text="MAIN MENU" Foreground="#747982" FontSize="10" FontWeight="Bold" Margin="24,0,0,12"/><Button Content="  HOME" HorizontalContentAlignment="Left" Margin="12,2" Click="Home_Click"/><Button Content="  SOCIAL" HorizontalContentAlignment="Left" Margin="12,2" Background="Transparent" Click="Social_Click"/><Button Content="  SESSIONS" HorizontalContentAlignment="Left" Margin="12,2" Background="Transparent" Click="Sessions_Click"/><Button Content="  PROFILE" HorizontalContentAlignment="Left" Margin="12,2" Background="Transparent" Click="Profile_Click"/><Button Content="  SETTINGS" HorizontalContentAlignment="Left" Margin="12,2" Background="Transparent" Click="Settings_Click"/></StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="22,18"><TextBlock Text="SERVICE STATUS" Foreground="#747982" FontSize="10" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#D6A63D" VerticalAlignment="Center"/><TextBlock x:Name="ApiStatusText" Text="Checking community services…" Foreground="#B7BAC1" FontSize="11" Margin="8,0,0,0"/></StackPanel><TextBlock Text="Independent community platform" Foreground="#666B74" FontSize="10" Margin="0,14,0,0"/></StackPanel></DockPanel></Border><Grid Grid.Column="1" Margin="34,28,34,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" Margin="0,0,0,25"><StackPanel DockPanel.Dock="Left"><TextBlock x:Name="PageEyebrow" Text="1.61ONLINE NETWORK" Foreground="#D7AD4A" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="PageTitle" Text="Welcome back" Foreground="#F4F4F5" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="SIGN IN" VerticalAlignment="Center" Background="#D6A63D" Foreground="#171717" Click="SignIn_Click"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PageContent"><Border Height="270" CornerRadius="9" Background="#25272B" ClipToBounds="True"><Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#39332A" Offset="0"/><GradientStop Color="#24272D" Offset="0.55"/><GradientStop Color="#17191E" Offset="1"/></LinearGradientBrush></Grid.Background><StackPanel VerticalAlignment="Center" Margin="34,0"><TextBlock Text="THE CITY IS YOURS" Foreground="#E6B84A" FontSize="12" FontWeight="Bold"/><TextBlock Text="Your community.&#x0a;Your next session." Foreground="White" FontSize="35" FontWeight="Bold" Margin="0,12,0,10"/><TextBlock Text="Connect with players and discover community-hosted sessions." Foreground="#C4C5C8" FontSize="14"/><Button Content="EXPLORE SESSIONS" HorizontalAlignment="Left" Margin="0,22,0,0" Background="#D6A63D" Foreground="#171717" Click="Sessions_Click"/></StackPanel></Grid></Border><Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="22"><StackPanel><TextBlock Text="COMMUNITY" Foreground="#E6B84A" FontSize="10" FontWeight="Bold"/><TextBlock Text=