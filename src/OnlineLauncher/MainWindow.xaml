<Window x:Class="OnlineLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="1.61ONLINE" Height="820" Width="1320" MinHeight="720" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="{StaticResource ShellBrush}"
        Foreground="#F5F5F6" FontFamily="Segoe UI" UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="252"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#292C32" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="24,29,20,28">
          <TextBlock Text="1.61ONLINE" Foreground="#F4F4F5" FontSize="24" FontWeight="Bold"/>
          <TextBlock Text="COMMUNITY NETWORK" Foreground="#D7AD4A" FontSize="10" FontWeight="Bold" Margin="1,6,0,0" CharacterSpacing="100"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="20,16,20,22">
          <Border Height="1" Background="#2A2D34" Margin="0,0,0,17"/>
          <TextBlock Text="SERVICE STATUS" Foreground="#747982" FontSize="10" FontWeight="Bold" Margin="2,0,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#D6A63D" VerticalAlignment="Center"/>
            <TextBlock x:Name="ApiStatusText" Text="Checking community API…" Foreground="#B7BAC1" FontSize="11" Margin="9,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Independent community services. Not affiliated with Rockstar Games." Foreground="#696E77" FontSize="10" TextWrapping="Wrap" Margin="0,13,0,0" LineHeight="15"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="NAVIGATION" Foreground="#747982" FontSize="10" FontWeight="Bold" Margin="25,0,0,11"/>
          <Button Style="{StaticResource NavigationButton}" Content="⌂   HOME" Click="Home_Click" Background="#26282E" Foreground="#F0D18A"/>
          <Button Style="{StaticResource NavigationButton}" Content="◎   SOCIAL" Click="Social_Click"/>
          <Button Style="{StaticResource NavigationButton}" Content="◈   SESSIONS" Click="Sessions_Click"/>
          <Button Style="{StaticResource NavigationButton}" Content="◉   PROFILE" Click="Profile_Click"/>
          <Button Style="{StaticResource NavigationButton}" Content="⚙   SETTINGS" Click="Settings_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="30,25,30,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="PageEyebrow" Text="1.61ONLINE NETWORK" Foreground="#D7AD4A" FontSize="10" FontWeight="Bold" CharacterSpacing="80"/>
          <TextBlock x:Name="PageTitle" Text="Welcome back" Foreground="#F4F4F5" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#202228" CornerRadius="5" Padding="12,9" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="#D6A63D" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="EnvironmentText" Text="LOCAL DEVELOPMENT" Foreground="#D8D9DC" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Button x:Name="AuthButton" Content="SIGN IN" Background="#E6B84A" Foreground="#171717" Click="SignIn_Click" MinWidth="105"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="#191B20" CornerRadius="5" Padding="13,9" Margin="0,0,0,18">
        <DockPanel LastChildFill="True">
          <TextBlock Text="COMMUNITY SERVICE" Foreground="#8D929B" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBlock x:Name="AccountText" Text="Signed out · You can browse the launcher locally" Foreground="#BEC1C7" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ContentControl x:Name="PageHost"/>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
